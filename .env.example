# Neon Postgres connection string
DATABASE_URL=

# Resend API key for sending emails
RESEND_API_KEY=

# Verified sender address for outbound emails
EMAIL_FROM=

# Port the Express API listens on (default 3000)
PORT=

# ── Worker Configuration Overrides ────────────────────────────────────

# Max attempts before job becomes dead (default 5)
MAX_ATTEMPTS=

# Base retry backoff delay in ms (default 1000)
BACKOFF_BASE_MS=

# Jitter added to backoff in ms (default 500)
BACKOFF_JITTER_MS=

# Worker concurrency cap (default 3)
CONCURRENCY=

# Worker polling interval in ms (default 1000)
POLL_INTERVAL_MS=

# Timeout before processing job is considered stuck in ms (default 300000)
STUCK_TIMEOUT_MS=

# Sweep interval for stuck jobs in ms (default 30000)
SWEEP_INTERVAL_MS=

# Worker process identifier (default random hex)
WORKER_ID=

# ── Test-only Knobs (for break-it tests only) ─────────────────────────

# Email sending mode: 'live' or 'dry' (default live)
EMAIL_MODE=

# Failure probability 0 to 1 before sending (default 0)
SIMULATE_FAILURE_RATE=

# Delay before sending in ms (default 0)
SIMULATE_DELAY_MS=

# Crash process after sending on attempt 1: 'true' or 'false' (default false)
SIMULATE_CRASH_AFTER_SEND=
